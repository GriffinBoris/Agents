class {{ spec.model }}ListView({{ base_view_name }}):
	def get(self, {{ route.params(detail=False) }}):
{% if route.parent %}
		{{ route.unpack((route.parent,)) }} = self.{{ route.resolver }}({{ route.resolver_args }})
{% endif %}
{% if filters %}

{% for entry in filters %}
{% if entry.kind == 'search' %}
		{{ entry.variable }} = request.query_params.get('{{ entry.param }}', '').strip()
{% else %}
		{{ entry.variable }} = request.query_params.get('{{ entry.param }}')
{% endif %}
{% endfor %}

		queryset = {{ route.queryset_base }}{{ queryset_suffix }}
{% for entry in filters %}

		if {{ entry.variable }}:
{% if entry.kind == 'search' %}
			queryset = queryset.filter({{ entry.search_expression }})
{% else %}
			valid_{{ entry.param|plural_snake }} = {choice for choice, _ in {{ spec.model }}.{{ entry.choices_class }}.choices}
			if {{ entry.variable }} not in valid_{{ entry.param|plural_snake }}:
				raise ValidationError({'{{ entry.param }}': 'Select a valid {{ entry.param|replace("_", " ") }} filter.'})

			queryset = queryset.filter({{ entry.fields[0] }}={{ entry.variable }})
{% endif %}
{% endfor %}

		queryset = queryset.order_by({{ ordering }})
{% else %}

		queryset = {{ route.queryset_base }}{{ queryset_suffix }}.order_by({{ ordering }})
{% endif %}
		serializer = {{ spec.model }}OutputSerializer(queryset, many=True, context={'request': request})
		return Response(serializer.data, status=status.HTTP_200_OK)
{% endif %}
{% if 'create' in spec.endpoints %}


class {{ spec.model }}CreateView({{ base_view_name }}):
	def post(self, {{ route.params(detail=False) }}):
{% if route.parent %}
		{{ route.unpack(write_scopes) }} = self.{{ route.resolver }}({{ route.resolver_args }})
{% endif %}
{% if permission_kwarg %}
		self.require_permission(request, AppPermission.permission(AppPermissionChoices.{{ spec.permission }}), {{ permission_kwarg }})
{% endif %}

		edited_data = self.build_serializer_data(request{{ route_owned_argument }})
		serializer = {{ spec.model }}InputSerializer(data=edited_data)
		serializer.is_valid(raise_exception=True)

		instance = serializer.save()
		return Response({{ spec.model }}OutputSerializer(instance, context={'request': request}).data, status=status.HTTP_201_CREATED)
{% endif %}
