class {{ spec.model }}DetailView({{ base_view_name }}):
	def get(self, {{ route.params(detail=True) }}):
{% if detail_lookup == 'resource_resolver' %}
		{{ route.unpack((), leaf=spec.resource) }} = self.{{ route.detail_resolver }}({{ route.detail_resolver_args }})
{% else %}
		{{ route.unpack((route.parent,)) }} = self.{{ route.resolver }}({{ route.resolver_args }})
		{{ spec.resource }} = get_object_or_404({{ route.queryset_base }}, id={{ route.id_kwarg }})
{% endif %}

		return Response({{ spec.model }}OutputSerializer({{ spec.resource }}, context={'request': request}).data, status=status.HTTP_200_OK)

	def put(self, {{ route.params(detail=True) }}):
{% if detail_lookup == 'resource_resolver' %}
		{{ route.unpack(write_scopes, leaf=spec.resource) }} = self.{{ route.detail_resolver }}({{ route.detail_resolver_args }})
{% else %}
		{{ route.unpack(write_scopes) }} = self.{{ route.resolver }}({{ route.resolver_args }})
		{{ spec.resource }} = get_object_or_404({{ route.queryset_base }}, id={{ route.id_kwarg }})
{% endif %}
{% if permission_kwarg %}
		self.require_permission(request, AppPermission.permission(AppPermissionChoices.{{ spec.permission }}), {{ permission_kwarg }})
{% endif %}

		edited_data = self.build_serializer_data(request{{ route_owned_argument }})
		serializer = {{ spec.model }}InputSerializer({{ spec.resource }}, data=edited_data, partial=True)
		serializer.is_valid(raise_exception=True)

		instance = serializer.save()
		return Response({{ spec.model }}OutputSerializer(instance, context={'request': request}).data, status=status.HTTP_200_OK)
{% endif %}
{% for action in actions %}


class {{ spec.model }}{{ action.class_fragment }}View({{ base_view_name }}):
	def post(self, {{ route.params(detail=True) }}):
{% if detail_lookup == 'resource_resolver' %}
		{{ route.unpack(action_scopes, leaf=spec.resource) }} = self.{{ route.detail_resolver }}({{ route.detail_resolver_args }})
{% else %}
		{{ route.unpack(action_scopes) }} = self.{{ route.resolver }}({{ route.resolver_args }})
		{{ spec.resource }} = get_object_or_404({{ route.queryset_base }}, id={{ route.id_kwarg }})
{% endif %}
{% if permission_kwarg %}
		self.require_permission(request, AppPermission.permission(AppPermissionChoices.{{ spec.permission }}), {{ permission_kwarg }})
{% endif %}

{% for assignment in action.assignments %}
		{{ spec.resource }}.{{ assignment.field }} = {{ assignment.value }}
{% endfor %}
		{{ spec.resource }}.save(update_fields=[{{ action.update_fields }}])
		return Response({{ spec.model }}OutputSerializer({{ spec.resource }}, context={'request': request}).data, status=status.HTTP_200_OK)
{% endfor %}
